# Base utilisee par le backend.
# Valeurs ci-dessous = Postgres local lance par docker-compose.
# Le conteneur backend surcharge DB_URL avec l'hote "postgres".
DB_URL=jdbc:postgresql://localhost:5432/DB_Sophatel
DB_USERNAME=sophatel
DB_PASSWORD=sophatel

# Base Neon (optionnel). Utilisee uniquement par scripts/neon-export.py.
# A renseigner pour reprendre un export des donnees distantes.
NEON_DB_URL=jdbc:postgresql://your-host/your-database?sslmode=require
NEON_DB_USERNAME=your_database_username
NEON_DB_PASSWORD=your_database_password

JWT_SECRET=replace_me_with_a_long_secure_secret
JWT_EXPIRATION=28800000

NATS_URL=nats://localhost:4222
NATS_SUBJECT=sophatel.demande.events
NATS_ENABLED=true

BREVO_SMTP_USERNAME=your_brevo_smtp_username
BREVO_SMTP_KEY=replace_me
APP_MAIL_FROM=your_verified_sender@example.com
APP_MAIL_FAIL_ON_ERROR=false

APP_FRONTEND_URL=http://localhost:4200
RESET_PASSWORD_TOKEN_EXPIRATION_MINUTES=30

MAIL_DEBUG=false
